{
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "runtime/infection/run.log",
        "stryker": {
            "report": "master"
        }
    },
    "tmpDir": "runtime/infection",
    "mutators": {
        "@default": true,
        "AssignCoalesce": {
            "ignore": [
                "Phptg\\BotApi\\ParseResult\\ObjectFactory::getTypeMap"
            ]
        }
    },
    "minCoveredMsi": 100
}
